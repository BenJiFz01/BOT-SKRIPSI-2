# .env.example — Bot Trading DSS Forex
# Salin ke .env dan isi sesuai konfigurasi. JANGAN commit .env ke repository.
# Bot berjalan 24 jam — tidak ada session filter. Sesi hanya info di notif sinyal.

# ── MetaTrader 5 ────────────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=password_mt5_anda
MT5_SERVER=NamaServer-Demo
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Offset zona waktu server MT5 terhadap UTC (jam). Tanpa ini bot membaca
# mt5.terminal_info().timezone otomatis (MetaQuotes agar waspada: UTC+3 di
# musim panas / UTC+2 musim dingin). Isi manual HANYA jika otomatis salah:
# MT5_SERVER_UTC_OFFSET_HOURS=3

# ── Telegram Bot ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Instrumen & Timeframe ───────────────────────────────────────────
SYMBOLS=XAUUSD
TIMEFRAMES=M5,M15,H1,H4,D1

# ── Pengambilan Data ────────────────────────────────────────────────
BARS=800
POLL_SECONDS=5

# ── Gate Threshold ──────────────────────────────────────────────────
MIN_RR=1.5
MIN_CONFIRM_VOTES=2
MIN_TRIGGER_SCORE=4
MIN_CONFLUENCE_SCORE=2
COOLDOWN_BARS=3
ATR_MIN_PCT=0.0006

# ── Market Transition (ADX) Gate ─────────────────────────────────────
# Rileks: block jika ADX TF penentu < 15 (tren mati), abu-abu 15-25 = +1 conf.
MARKET_TRANSITION_ADX_BLOCK=15.0
MARKET_TRANSITION_ADX_GRAY=25.0

# ── HTF Bias Vote ────────────────────────────────────────────────
# Scalping: cukup H1 saja (data: H4 ikut menurunkan WR). Intraday: D1 wajib.
SCALPING_H1_ONLY=true
INTRADAY_REQUIRE_D1=true

# ── SL/TP Berbasis ATR ──────────────────────────────────────────────
SL_ATR_MULT=1.5
TP1_RR=1.5
TP2_RR=2.5
TP3_RR=4.0
MAX_SL_POINTS=50.0

# Cap SL per timeframe (dalam poin absolut)
MAX_SL_M5=5.0
MAX_SL_M15=5.0
MAX_SL_H1=15.0
MAX_SL_H4=30.0
MAX_SL_D1=50.0

# ── SL/TP Fixed Pip (fallback jika ATR tidak valid) ─────────────────
SL_PIPS=50.0
TP1_PIPS=70.0
TP2_PIPS=100.0
TP3_PIPS=140.0
PIP_SIZE=0.1

# ── Counter Trend ───────────────────────────────────────────────────
# 2026-09-17: direkomendasikan false — data menunjukkan REVERSAL WR 18%.
# Momentum tetap tertangkap via CONTINUATION + MOM_RECOVERY (scalping).
COUNTER_TREND_ENABLED=false
COUNTER_TREND_TFS=H1,H4
MIN_COUNTER_CONFLUENCE=3
COUNTER_TREND_MIN_RR=2.0

# ── Scalping Mode (M5/M15) ──────────────────────────────────────────
# Norma riset: TP1=1.0-1.5×ATR (~135 pip M15), TP2=2.4×ATR, TP3=3.9×ATR (runner).
# SL 1.2×ATR + entry zone 0.3×ATR → R basis = 1.5×ATR dari entry-high.
SCALPING_MIN_TRIGGER_SCORE=3
SCALPING_MIN_CONFLUENCE_SCORE=2
SCALPING_ATR_MIN_POINTS=5.0
SCALPING_SL_ATR_MULT=1.2
SCALPING_COOLDOWN_BARS_M5=9
SCALPING_COOLDOWN_BARS_M15=5
SCALPING_TP1_RR=1.0
SCALPING_TP2_RR=1.6
SCALPING_TP3_RR=2.6
SCALPING_MIN_RR=1.0
