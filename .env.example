# ══════════════════════════════════════════════════════════════════════
# .env.example — Bot Trading DSS Forex (Skripsi)
# Salin file ini menjadi .env dan isi sesuai konfigurasi Anda.
# JANGAN commit file .env ke repository (sudah ada di .gitignore).
# ══════════════════════════════════════════════════════════════════════

# ── MetaTrader 5 ────────────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=password_mt5_anda
MT5_SERVER=NamaServer-Demo

# ── Telegram Bot ────────────────────────────────────────────────────
# Buat bot via @BotFather di Telegram, dapatkan token.
# Chat ID bisa didapat via @userinfobot atau @getidsbot.
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Instrumen & Timeframe ───────────────────────────────────────────
# Pisahkan dengan koma. Timeframe yang didukung: M5,M15,H1,H4,D1
SYMBOLS=XAUUSD
TIMEFRAMES=M5,M15,H1,H4,D1

# ── Pengambilan Data ────────────────────────────────────────────────
BARS=800              # Jumlah candle yang diambil per TF (min 220)
POLL_SECONDS=5        # Interval polling deteksi candle close (detik)

# ── Gate Threshold (Filter Keputusan) ───────────────────────────────
# MIN_RR: Minimum Risk-Reward Ratio. Default 1.5 (RR 1:1.5)
MIN_RR=1.5

# MIN_CONFIRM_VOTES: Minimum TF lebih tinggi yang harus setuju dengan bias.
# Default 2 (Fix #3: naik dari 1). Untuk M5, minimal H1 harus setuju.
MIN_CONFIRM_VOTES=2

# MIN_TRIGGER_SCORE: Minimum skor Layer-1 (dari 6 komponen). Default 4.
# Semakin tinggi = lebih selektif, lebih sedikit sinyal tapi lebih kuat.
MIN_TRIGGER_SCORE=4

# MIN_CONFLUENCE_SCORE: Minimum skor Layer-2 (Pattern+Fib+SnR+SnD+Divergence).
# Default 2. Pastikan ada minimal 2 konfirmasi tambahan.
MIN_CONFLUENCE_SCORE=2

# COOLDOWN_BARS: Jeda minimum antar sinyal (dalam satuan bar trigger TF).
# Default 3 bar. Mencegah spam sinyal di kondisi choppy.
COOLDOWN_BARS=3

# ATR_MIN_PCT: ATR minimum sebagai % dari harga. Market terlalu flat ditolak.
ATR_MIN_PCT=0.0006

# ── SL/TP Berbasis ATR (Primary) ────────────────────────────────────
# SL = SL_ATR_MULT × ATR dari entry price
SL_ATR_MULT=1.5

# TP dihitung sebagai multiple dari SL distance (Risk-Reward)
TP1_RR=1.5    # TP1 = RR 1:1.5
TP2_RR=2.5    # TP2 = RR 1:2.5
TP3_RR=4.0    # TP3 = RR 1:4.0

# SL maksimal dalam poin absolut (cap agar SL tidak terlalu lebar saat ATR tinggi)
# Untuk XAU/USD: 50 poin = selisih harga 50.0 (misal entry 3310 → SL maks 3260/3360)
# Contoh: ATR=40, SL_ATR_MULT=1.5 → SL ATR = 60 poin → di-cap jadi 50 poin
#          ATR=20, SL_ATR_MULT=1.5 → SL ATR = 30 poin → tidak kena cap (30 < 50)
# Set 0 untuk menonaktifkan cap ini.
MAX_SL_POINTS=50.0

# ── SL/TP Fixed Pip (Fallback jika ATR tidak valid) ─────────────────
SL_PIPS=50.0
TP1_PIPS=70.0
TP2_PIPS=100.0
TP3_PIPS=140.0
PIP_SIZE=0.1      # Untuk XAU/USD: 1 pip = 0.1 (misal harga 3300.0)

# ── Session Filter ──────────────────────────────────────────────────
# Jika true, sinyal M5/M15/H1 hanya dikirim di London + NY session (WIB).
# H4 dan D1 tidak dipengaruhi session filter.
# Jam aktif: 14:00–02:00 WIB (London+NY)
SESSION_FILTER=true


# ── Counter Trend ───────────────────────────────────────────────────
# Aktifkan mode counter trend (sinyal melawan bias HTF).
# Counter trend hanya diizinkan jika ada bukti kuat reversal:
#   - Divergence RSI atau MACD (wajib)
#   - Fibonacci golden zone (38.2%, 50%, 61.8%)
#   - Supply/Demand Zone aktif
#
# COUNTER_TREND_ENABLED: true = aktifkan, false = matikan (hanya trend following)
# COUNTER_TREND_TFS    : TF yang boleh kirim sinyal counter trend
#                        Default H1,H4 -- M5/M15 terlalu noise untuk counter trend
# MIN_COUNTER_CONFLUENCE: Minimum skor konfluensi counter trend (lebih ketat dari trend biasa)
#                         Default 3 (vs 2 untuk trend following)
# COUNTER_TREND_MIN_RR : Minimum RR untuk counter trend (lebih tinggi karena lebih berisiko)
#                        Default 2.0 (vs 1.5 untuk trend following)
COUNTER_TREND_ENABLED=true
COUNTER_TREND_TFS=H1,H4
MIN_COUNTER_CONFLUENCE=3
COUNTER_TREND_MIN_RR=2.0
