# .env.example — Bot Trading DSS Forex
# Salin ke .env dan isi sesuai konfigurasi. JANGAN commit .env ke repository.
# Bot berjalan 24 jam — tidak ada session filter. Sesi hanya info di notif sinyal.

# ── MetaTrader 5 ────────────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=password_mt5_anda
MT5_SERVER=NamaServer-Demo
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Offset zona waktu server MT5 terhadap UTC (jam). Jika dikosongkan, bot
# mendeteksi otomatis dari selisih jam tick server vs UTC (mengakomodasi DST).
# Isi manual HANYA jika deteksi otomatis salah:
# MT5_SERVER_UTC_OFFSET_HOURS=3

# ── Telegram Bot ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Instrumen & Timeframe ───────────────────────────────────────────
SYMBOLS=XAUUSD
TIMEFRAMES=M5,M15,H1,H4,D1

# ── Pengambilan Data ────────────────────────────────────────────────
BARS=800
POLL_SECONDS=5

# ── Gate Threshold ──────────────────────────────────────────────────
MIN_RR=1.5
MIN_CONFIRM_VOTES=2
MIN_TRIGGER_SCORE=4
MIN_CONFLUENCE_SCORE=2
COOLDOWN_BARS=3
ATR_MIN_PCT=0.0006

# ── Market Transition (ADX) Gate ─────────────────────────────────────
# Rileks: block jika ADX TF penentu < 15 (tren mati), abu-abu 15-25 = +1 conf.
MARKET_TRANSITION_ADX_BLOCK=15.0
MARKET_TRANSITION_ADX_GRAY=25.0

# ── HTF Bias Vote ────────────────────────────────────────────────
# Scalping: cukup H1 saja (data: H4 ikut menurunkan WR). Intraday: D1 wajib.
SCALPING_H1_ONLY=true
INTRADAY_REQUIRE_D1=true

# ── SL/TP Pure ATR-based (NEW SYSTEM) ──────────────────────────────
# Sistem baru: SL = max(swing±buffer, atr_sl) + clamp [min_spread, max_atr]
# TP = sl_dist × tp_rr. Reject jika SL di luar clamp range.

SPREAD=0.30

# Scalping (M5/M15): ATR(14) di M5
SCALPING_ATR_LEN=14
SCALPING_SL_BUFFER_ATR=0.3
SCALPING_MIN_SPREAD_MULT=3.0
SCALPING_MAX_ATR_MULT=2.0

# Intraday (H1+): ATR(14) di M15/H1
INTRADAY_ATR_LEN=14
INTRADAY_SL_ATR_MULT=1.5
INTRADAY_SL_BUFFER_ATR=0.5
INTRADAY_MIN_SPREAD_MULT=5.0
INTRADAY_MAX_ATR_MULT=2.5
INTRADAY_TP1_RR=1.0
INTRADAY_TP2_RR=2.0
INTRADAY_TP3_RR=3.0

# Obstacle TP adjustment: min_rr = OBSTACLE_MIN_RR_FRAC × tp_rr
# 0.8 = allow adjustment if new RR >= 80% nominal (e.g., TP2 1.5R → min 1.2R)
OBSTACLE_MIN_RR_FRAC=0.8

# ── SL/TP Legacy (DEPRECATED, hanya untuk kompatibilitas) ───────────
SL_ATR_MULT=1.5
TP1_RR=1.5
TP2_RR=2.5
TP3_RR=4.0
MAX_SL_POINTS=50.0
MAX_SL_M5=10.0
MAX_SL_M15=10.0
MAX_SL_H1=15.0
MAX_SL_H4=30.0
MAX_SL_D1=50.0

# ── SL/TP Fixed Pip (fallback emergency) ────────────────────────────
SL_PIPS=50.0
TP1_PIPS=70.0
TP2_PIPS=100.0
TP3_PIPS=140.0
PIP_SIZE=0.1

# ── Counter Trend ───────────────────────────────────────────────────
# 2026-09-17: direkomendasikan false — data menunjukkan REVERSAL WR 18%.
# Momentum tetap tertangkap via CONTINUATION + MOM_RECOVERY (scalping).
COUNTER_TREND_ENABLED=false
COUNTER_TREND_TFS=H1,H4
MIN_COUNTER_CONFLUENCE=3
COUNTER_TREND_MIN_RR=2.0

# ── Scalping Mode (M5/M15) ──────────────────────────────────────────
# TP ladder RR-based: TP1=1.0R, TP2=1.5R, TP3=2.0R (pure ATR system).
# SL = max(swing, atr_sl) dengan clamp [3×spread, 2×ATR].
SCALPING_MIN_TRIGGER_SCORE=3
SCALPING_MIN_CONFLUENCE_SCORE=2
SCALPING_ATR_MIN_POINTS=3.0
SCALPING_SL_ATR_MULT=1.2
SCALPING_COOLDOWN_BARS_M5=6
SCALPING_COOLDOWN_BARS_M15=5
SCALPING_TP1_ATR_MULT=0
SCALPING_TP1_RR=1.0
SCALPING_TP2_RR=1.5
SCALPING_TP3_RR=2.0
SCALPING_MIN_RR=1.0
SCALPING_OVEREXTEND_ATR_MULT=1.2
SCALPING_PULLBACK_ENABLED=true
# Konfluensi scalping entry-timing (2026-09-24): AKTIF + detector dilonggarkan
# (wick 0.3, FVG gap 0.3 ATR/age 60, near 1.5xATR) — detector lama nyaris tak
# pernah trigger (FVG_OK 0%). Evaluasi akurasi via get_stats()/analisis_sweep_fvg.py.
SCALPING_LIQUIDITY_SWEEP_ENABLED=true
SCALPING_FVG_ENABLED=true
# ── Market State Detector (2026-09-24) ────────────────────────────────────────
# Adaptasi logic terhadap kondisi pasar: TRENDING→(pullback/momentum), RANGE→
# rejection di level kunci, BREAKOUT/HIGH_MOMENTUM→gate dilonggarkan, TRANSITION→
# continuation diblokir. Anti-chase (OVEREXTENSION/LATE_ENTRY) tetap aktif.
# Lebar band EMA200 (×ATR) jalur momentum/breakout (tren kuat tanpa pullback).
MOMENTUM_EMA200_TOLERANCE=1.0
# RANGE lane: bias netral + ADX rendah → candle-rejection wajib ada key level (SnR/SnD).
RANGE_REJECTION_ENABLED=true
# ── Tuas keketatan/reaksi (A/B testing tanpa ubah kode) ────────────────────────
# Jalur VETO+FLIP: LTF berbalik → sinyal searah bias diblokir, arah lawan dievaluasi
# (atau awal tren). OFF → sistem 100% ke perilaku lama (tidak pernah blokir/flip).
LTF_VETO_ENABLED=true
# FLIP wajib trigger mini. 3 = ketat; 2 = longgar (struktur bisa menutupi trigger <3).
FLIP_MIN_TRIGGER=3
# FLIP wajib ada key level (SnR/SnD) — OFF → FLIP boleh di tengah jalan (risiko tinggi).
FLIP_REQUIRE_KEY_LEVEL=true
# H1 wajib key level — OFF bila H1 terlalu jarang sinyal (WR H1 historis 19% tanpa gate ini).
H1_REQUIRE_KEY_LEVEL=true
# Floor trigger jalur PULLBACK (kasus 29th: setup 0/6 lolos) — naikkan ke 3 utk lebih ketat.
SCALPING_PULLBACK_MIN_TRIGGER=2
# Quality key-level gate (30/09): di pasar RANGE/sideways, continuation wajib level BERKUALITAS
# (SnR 3-touch / FIB_GOLDEN) — SnR_WEAK 2-touch tak dihitung (rumus loss 12:00 vs WIN 12:50/13:45).
# OFF = longgar, continuation level lemah tetap boleh di RANGE.
RANGE_QUALITY_KEY_LEVEL=true
