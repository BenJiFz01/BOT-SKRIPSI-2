# .env.example — Bot Trading DSS Forex
# Salin ke .env dan isi sesuai konfigurasi. JANGAN commit .env ke repository.

# ── MetaTrader 5 ────────────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=password_mt5_anda
MT5_SERVER=NamaServer-Demo
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Telegram Bot ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Instrumen & Timeframe ───────────────────────────────────────────
SYMBOLS=XAUUSD
TIMEFRAMES=M5,M15,H1,H4,D1

# ── Pengambilan Data ────────────────────────────────────────────────
BARS=800
POLL_SECONDS=5

# ── Gate Threshold ──────────────────────────────────────────────────
MIN_RR=1.5
MIN_CONFIRM_VOTES=2
MIN_TRIGGER_SCORE=4
MIN_CONFLUENCE_SCORE=2
COOLDOWN_BARS=3
ATR_MIN_PCT=0.0006

# ── SL/TP Berbasis ATR ──────────────────────────────────────────────
SL_ATR_MULT=1.5
TP1_RR=1.5
TP2_RR=2.5
TP3_RR=4.0
MAX_SL_POINTS=50.0

# Cap SL per timeframe (dalam poin absolut)
MAX_SL_M5=5.0
MAX_SL_M15=5.0
MAX_SL_H1=15.0
MAX_SL_H4=30.0
MAX_SL_D1=50.0

# ── SL/TP Fixed Pip (fallback jika ATR tidak valid) ─────────────────
SL_PIPS=50.0
TP1_PIPS=70.0
TP2_PIPS=100.0
TP3_PIPS=140.0
PIP_SIZE=0.1

# ── Session Filter ──────────────────────────────────────────────────
# true = sinyal M5/M15/H1 hanya di jam London+NY (14:00-02:00 WIB)
SESSION_FILTER=true

# ── Counter Trend ───────────────────────────────────────────────────
COUNTER_TREND_ENABLED=true
COUNTER_TREND_TFS=H1,H4
MIN_COUNTER_CONFLUENCE=3
COUNTER_TREND_MIN_RR=2.0

# ── Scalping Mode (M5/M15) ──────────────────────────────────────────
SCALPING_MIN_TRIGGER_SCORE=3
SCALPING_MIN_CONFLUENCE_SCORE=1
SCALPING_SL_ATR_MULT=1.2
SCALPING_COOLDOWN_BARS=5
SCALPING_TP1_RR=1.5
SCALPING_TP2_RR=2.0
SCALPING_TP3_RR=2.5
